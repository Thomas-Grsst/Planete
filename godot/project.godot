; Engine configuration file.

config_version=5

[application]

config/name="Petite Planète"
config/description="Un petit monde vivant dans ta poche. Tu ne le diriges pas : tu l'observes."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Sim="*res://scripts/sim/sim.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.06, 0.1, 0.14, 1)
anti_aliasing/quality/msaa_2d=1
